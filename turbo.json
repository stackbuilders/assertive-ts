{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**"],
      "outputs": ["dist/**"]
    },
    "check": {
      "cache": false,
      "dependsOn": ["^build", "^compile"]
    },
    "compile": {
      "dependsOn": ["^build"],
      "outputs": ["build/**"]
    },
    "docs": {
      "cache": false,
      "dependsOn": ["^build"],
      "inputs": ["src/**", "typings/**"],
      "outputs": ["docs/*/build/**"]
    },
    "release": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["CI", "GITHUB_*", "GH_*", "NPM_*", "YARN_*", "ACTIONS_*", "RUNNER_*", "GIT_*", "SEMANTIC_RELEASE_*", "DEBUG"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "test/**/*.ts"],
      "outputs": []
    }
  }
}
