{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn compile:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn test:*)",
      "Bash(yarn check:*)",
      "Bash(yarn why:*)",
      "Bash(yarn npm audit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Bash(yarn release:*)",
      "Bash(yarn run release:*)",
      "Bash(npm publish:*)",
      "Bash(yarn npm publish:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(/.github/workflows/release.yml)",
      "Write(/.github/workflows/release.yml)",
      "Edit(/.yarn/releases/**)",
      "Write(/.yarn/releases/**)"
    ]
  }
}
